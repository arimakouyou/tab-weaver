{
  "name": "tab-weaver",
  "version": "1.0.0",
  "description": "タブ情報を美しくMarkdown形式で整理するChrome拡張機能",
  "main": "popup/popup.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint popup/**/*.js background/**/*.js --fix",
    "build": "npm run test:ci && npm run lint",
    "dev": "npm run test:watch",
    "icons:generate": "node scripts/convert-icons-sharp.js",
    "icons:manual": "echo 'ブラウザで scripts/svg-to-png.html を開いてください'"
  },
  "keywords": [
    "chrome-extension",
    "tabs",
    "markdown",
    "productivity"
  ],
  "author": "TabList Extension Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-transform-class-properties": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@types/chrome": "^0.0.246",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-chrome": "^0.8.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-extended": "^6.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "popup/**/*.js",
      "background/**/*.js",
      "!popup/popup.js",
      "!**/node_modules/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 75,
        "lines": 75,
        "statements": 75
      }
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "moduleFileExtensions": [
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "globals": {
      "chrome": {}
    }
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "webextensions": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "script"
    },
    "globals": {
      "chrome": "readonly",
      "module": "readonly",
      "exports": "readonly"
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "warn",
      "prefer-const": "error",
      "no-var": "error"
    }
  }
}
