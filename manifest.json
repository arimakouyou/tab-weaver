{
  "manifest_version": 3,
  "name": "Tab Weaver",
  "version": "1.0.0",
  "description": "タブ情報を美しくMarkdown形式で整理するChrome拡張機能",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "contextMenus",
    "notifications",
    "scripting",
    "alarms"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tab Weaver",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https:;"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  }
}